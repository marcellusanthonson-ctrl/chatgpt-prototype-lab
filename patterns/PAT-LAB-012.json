{"schema_version":"1.0.0","id":"PAT-LAB-012","project_id":"lab","title":"Confirmed incidents constrain decisions but historical errors do not prove current recurrence","status":"VALIDATED_TRANSVERSAL_PATTERN","validation_state":"VALIDATED_BY_STATIC_CONTRACT_NEGATIVE_CASES_AND_PRODUCT_LEADERSHIP_TRACEABILITY","canonical_path":"patterns/PAT-LAB-012.json","updated_at":"2026-08-05","principle":"Before a complex execution, retrieve only applicable confirmed incidents, verify whether each is currently reproduced, apply its preventive control within authority, and record the decision impact. Historical presence alone never proves current recurrence.","required_controls":["BRIEF_LEARNING_CONTEXT","APPLICABILITY_FILTER","CURRENT_EVIDENCE_CHECK","CONFIRMED_NOT_REPRODUCED_NOT_APPLICABLE_OR_INSUFFICIENT_DETERMINATION","PREVENTIVE_CONTROL_MAPPING","FAIL_CLOSED_ON_UNRESOLVED_MATERIAL_RECURRENCE","LEARNING_APPLICATION_REPORT_WITHOUT_PRIVATE_CHAIN_OF_THOUGHT"],"approved_by":"Jonathan Martínez","authorization_ref":"AUTHORIZATION_LAB_TRANSVERSAL_EXECUTION_LEARNING_AND_PRODUCT_LEADERSHIP_READINESS_REMEDIATION_193","source_refs":["errors/ERR-LAB-013.json","architecture/governance/EXECUTION_LEARNING_FEEDBACK_LOOP_001/CONTRACT.json","architecture/governance/EXECUTION_LEARNING_FEEDBACK_LOOP_001/CODEX_DECISION_PROTOCOL.json","projects/lab/programs/PRIORITY-INTEGRATIONS-PROGRAM-001/product-leadership/INCIDENT_LEDGER.json"],"authority_effect":"NONE"}
