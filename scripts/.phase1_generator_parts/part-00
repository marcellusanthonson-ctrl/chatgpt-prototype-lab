def load(rel: str):
    return json.loads((ROOT / rel).read_text(encoding="utf-8"))

def save(rel: str, value):
    path = ROOT / rel
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8", newline="\n")

def append_unique(seq, value):
    if value not in seq:
        seq.append(value)

def increment_patch(version: str) -> str:
    parts = version.split(".")
    if len(parts) == 3 and all(p.isdigit() for p in parts):
        parts[-1] = str(int(parts[-1]) + 1)
        return ".".join(parts)
    return version

def materialize() -> None:
    encoded = "".join(p.read_text(encoding="ascii").strip() for p in sorted(PAYLOAD_DIR.glob("chunk-*.txt")))
    payload = json.loads(zlib.decompress(base64.b64decode(encoded)).decode("utf-8"))
    for rel, content in payload.items():
        path = ROOT / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8", newline="\n")

