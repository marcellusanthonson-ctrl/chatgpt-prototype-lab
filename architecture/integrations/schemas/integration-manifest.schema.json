{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.local/architecture/integrations/schemas/integration-manifest.schema.json",
  "title": "MANIFEST",
  "description": "Executable provider-neutral M1A contract. Structured UNRESOLVED values are permitted only where canonical sources do not establish a value.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "authority_effect",
    "runtime_effect",
    "automatic_activation",
    "implementation_authorized",
    "integration_id",
    "module_id",
    "version",
    "status",
    "profile",
    "producer",
    "consumer",
    "contract_refs",
    "evidence_refs",
    "compatibility",
    "rollback_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "MANIFEST"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "runtime_effect": {
      "const": "NONE"
    },
    "automatic_activation": {
      "const": false
    },
    "implementation_authorized": {
      "const": false
    },
    "integration_id": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "enum": [
        "EVIDENCE_AND_CLAIMS",
        "DESIGN_CRITERION",
        "WEB_ACCESSIBILITY",
        "CONTEXTUAL_VISUAL_PREFERENCE"
      ]
    },
    "version": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/unresolved"
        }
      ]
    },
    "status": {
      "const": "CANDIDATE"
    },
    "profile": {
      "const": "CRITERION_MODULE"
    },
    "producer": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/unresolved"
        }
      ]
    },
    "consumer": {
      "type": "string",
      "minLength": 1
    },
    "contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "compatible_with",
        "conflicts_with"
      ],
      "properties": {
        "compatible_with": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflicts_with": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "$ref": "#/$defs/unresolved"
            }
          ]
        }
      }
    },
    "rollback_ref": {
      "const": "ROLLBACK.json"
    }
  },
  "$defs": {
    "unresolved": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "required_resolution",
        "source_refs"
      ],
      "properties": {
        "status": {
          "const": "UNRESOLVED"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required_resolution": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "authority_effect": "NONE",
  "runtime_effect": "NONE",
  "automatic_activation": false,
  "implementation_authorized": false
}
