{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.local/architecture/integrations/schemas/composition-contract.schema.json",
  "title": "COMPOSITION_CONTRACT",
  "description": "Executable provider-neutral M1A contract. Structured UNRESOLVED values are permitted only where canonical sources do not establish a value.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "authority_effect",
    "runtime_effect",
    "automatic_activation",
    "implementation_authorized",
    "precedence_class",
    "compatible_with",
    "conflicts_with",
    "supersedes",
    "maximum_role",
    "conflict_keys",
    "composition_rules",
    "exclusions",
    "empty_set_abstention"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "COMPOSITION_CONTRACT"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "runtime_effect": {
      "const": "NONE"
    },
    "automatic_activation": {
      "const": false
    },
    "implementation_authorized": {
      "const": false
    },
    "precedence_class": {
      "type": "integer",
      "minimum": 1
    },
    "compatible_with": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicts_with": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "$ref": "#/$defs/unresolved"
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maximum_role": {
      "type": "string",
      "minLength": 1
    },
    "conflict_keys": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "composition_rules": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1
    },
    "empty_set_abstention": {
      "const": true
    }
  },
  "$defs": {
    "unresolved": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "required_resolution",
        "source_refs"
      ],
      "properties": {
        "status": {
          "const": "UNRESOLVED"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required_resolution": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "authority_effect": "NONE",
  "runtime_effect": "NONE",
  "automatic_activation": false,
  "implementation_authorized": false
}
