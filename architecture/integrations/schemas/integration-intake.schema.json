{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.local/architecture/integrations/schemas/integration-intake.schema.json",
  "title": "INTEGRATION_INTAKE",
  "description": "Executable provider-neutral M1A contract. Structured UNRESOLVED values are permitted only where canonical sources do not establish a value.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "authority_effect",
    "runtime_effect",
    "automatic_activation",
    "implementation_authorized",
    "integration_id",
    "profile",
    "problem",
    "producer",
    "consumer",
    "value_hypothesis",
    "risk_signals",
    "rollback_strategy",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "INTEGRATION_INTAKE"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "runtime_effect": {
      "const": "NONE"
    },
    "automatic_activation": {
      "const": false
    },
    "implementation_authorized": {
      "const": false
    },
    "integration_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "const": "CRITERION_MODULE"
    },
    "problem": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/unresolved"
        }
      ]
    },
    "producer": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/unresolved"
        }
      ]
    },
    "consumer": {
      "type": "string",
      "minLength": 1
    },
    "value_hypothesis": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/unresolved"
        }
      ]
    },
    "risk_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback_strategy": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "unresolved": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "required_resolution",
        "source_refs"
      ],
      "properties": {
        "status": {
          "const": "UNRESOLVED"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required_resolution": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "authority_effect": "NONE",
  "runtime_effect": "NONE",
  "automatic_activation": false,
  "implementation_authorized": false
}
