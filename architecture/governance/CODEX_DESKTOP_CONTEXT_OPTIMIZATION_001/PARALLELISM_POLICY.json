{
  "schema_version": "1.0.0",
  "policy_id": "CODEX-DESKTOP-CONTROLLED-PARALLELISM-001",
  "parallel_allowed": [
    "READ_ONLY_DISCOVERY_OF_DISJOINT_SUBSYSTEMS",
    "DOCUMENTATION_REVIEW_OF_DISJOINT_SOURCE_SETS",
    "INDEPENDENT_TEST_GROUPS_WITH_NO_SHARED_MUTABLE_STATE",
    "ALTERNATIVE_SOLUTION_EXPLORATION_WITHOUT_CANONICAL_MUTATION",
    "AUDIT_OF_ALREADY_FROZEN_ARTIFACTS"
  ],
  "must_be_sequential": [
    "EDITS_TO_THE_SAME_FILE_OR_OVERLAPPING_PATHS",
    "IMPLEMENTATION_DEPENDENT_ON_A_PRIOR_DECISION",
    "CANONICAL_STATE_TRANSITIONS",
    "COMMIT_PUSH_PULL_REQUEST_MERGE_AND_AUTHORIZATION_CONSUMPTION",
    "AUDIT_BEFORE_IMPLEMENTATION_IS_FROZEN",
    "HANDOFFS_WHERE_DOWNSTREAM_INPUT_IS_NOT_IMMUTABLE"
  ],
  "worktree_rule": "WRITE_CAPABLE_THREADS_USE_SEPARATE_WORKTREES_OR_SEQUENTIAL_EXECUTION; NO_TWO_WRITERS_OWN_THE_SAME_PATH.",
  "merge_rule": "ONE_CONTROLLER_SERIALIZES_INTEGRATION_AND_PUBLICATION.",
  "measurement": [
    "elapsed_time",
    "aggregate_agent_time",
    "coordination_overhead",
    "merge_conflicts",
    "rework_cycles"
  ],
  "authority_effect": "NONE"
}
