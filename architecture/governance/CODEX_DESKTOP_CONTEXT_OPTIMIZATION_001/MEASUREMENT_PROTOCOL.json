    "always_required_source_count",
    "sources_actually_read",
    "applicable_incidents_loaded",
    "time_to_first_useful_command_seconds",
    "time_to_first_material_change_seconds",
    "total_elapsed_seconds",
    "agent_thread_count",
    "correction_cycles",
    "validation_failures",
    "unexpected_stop_conditions",
    "final_contract_pass",
    "omitted_material_constraints"
  ],
  "success_rule": "FASTER_OR_LOWER_CONTEXT_WITH_NO_DEGRADATION_IN_COMPLETENESS_AUTHORITY_COMPLIANCE_VALIDATION_OR_ERROR_RATE",
  "claim_limits": [
    "STATIC_STANDARD_PASS_DOES_NOT_PROVE_RUNTIME_SPEEDUP",
