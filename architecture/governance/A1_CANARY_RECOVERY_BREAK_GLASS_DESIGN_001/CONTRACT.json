    "existing_required_approving_review_count_must_return_to": 1,
    "future_recovery_operator_must_be_explicitly_named": true,
    "if_no_distinct_valid_reviewer_or_required_separation_is_available": "STOP_FAIL_CLOSED",
    "independent_post_restoration_readback_required": true,
