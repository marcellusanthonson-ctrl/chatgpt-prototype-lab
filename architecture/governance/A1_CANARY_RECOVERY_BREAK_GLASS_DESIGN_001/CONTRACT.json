      "THE_FUTURE_AUTHORIZATION_BASELINE_IS_STILL_CURRENT_AT_ACTIVATION_TIME",
      "THE_RECOVERY_REMAINS_CANARY_ONLY"
    ],
    "insufficient_triggers": [
      "CONVENIENCE",
      "FASTER_MERGE",
      "FAILED_OR_MISSING_REVIEW",
      "FAILED_REQUIRED_STATUS_CHECK",
      "DESIRE_TO_SKIP_A1_GATES",
      "MAIN_BRANCH_RECOVERY",
      "UNVERIFIED_OR_AMBIGUOUS_INCIDENT"
    ],
    "activation_on_ambiguity": "DENIED_FAIL_CLOSED"
  },
  "human_approval_model": {
