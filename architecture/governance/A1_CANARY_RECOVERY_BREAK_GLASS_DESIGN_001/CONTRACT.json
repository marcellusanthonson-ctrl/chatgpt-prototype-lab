    "repository": "marcellusanthonson-ctrl/chatgpt-prototype-lab",
    "canary_branch": "lab-governance-canary-210",
    "canary_ruleset_id": 20573868,
    "main_branch_effect": "PROHIBITED"
  },
  "normal_state": {
    "state": "DISABLED_NO_STANDING_BYPASS_NO_RESIDUAL_AUTHORITY",
    "ruleset_enforcement": "active",
    "required_approving_review_count": 1,
    "required_status_checks": [
      "LAB Publication Gate",
      "LAB Canonical Authority Gate v2"
    ],
    "bypass_actors": [],
    "current_user_can_bypass": "never",
    "standing_recovery_principal": "NONE",
    "automatic_activation": false
  },
  "activation_trigger": {
    "policy": "ALL_REQUIRED_CONDITIONS_MUST_BE_TRUE",
