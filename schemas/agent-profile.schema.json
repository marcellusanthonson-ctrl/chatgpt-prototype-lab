{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.local/schemas/agent-profile.schema.json",
  "title": "Codex Desktop agent profile",
  "type": "object",
  "required": ["schema_version", "profile_id", "status", "surface", "mode", "purpose", "authority_effect", "write_access", "required_inputs", "required_outputs", "required_behavior", "stop_conditions", "handoff"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"enum": ["LAB_DISCOVERY", "LAB_IMPLEMENTATION", "LAB_VALIDATION", "LAB_AUDIT"]},
    "status": {"const": "ACTIVE_PROFILE"},
    "surface": {"const": "CODEX_DESKTOP"},
    "mode": {"type": "string"},
    "purpose": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "NONE_ROLE_PROFILE_DOES_NOT_AUTHORIZE_EXECUTION"},
    "write_access": {"type": "object"},
    "required_inputs": {"type": "array", "items": {"type": "string"}},
    "required_outputs": {"type": "array", "minItems": 1},
    "required_behavior": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "handoff": {"type": "object", "required": ["to", "frozen_output"]},
    "learning_contract": {"type": "string"},
    "private_chain_of_thought": {"const": "NOT_REQUIRED_NOT_RECORDED"}
  },
  "additionalProperties": true
}
