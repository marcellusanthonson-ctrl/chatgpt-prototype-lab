{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.local/schemas/motion-source-fidelity-contract.schema.json",
  "title": "Motion source-fidelity contract",
  "type": "object",
  "required": ["schema_version", "status", "required_distinctions", "reference_implementation", "exact", "prohibited"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["DRAFT", "HUMAN_REVIEW_PENDING", "HUMAN_APPROVED", "REJECTED"]},
    "required_distinctions": {
      "type": "array",
      "items": {"enum": ["REFERENCE_IMPLEMENTATION", "BEHAVIOR_CORE", "NEUTRAL_ADAPTATION", "PROJECT_ADAPTATION"]},
      "allOf": [
        {"contains": {"const": "REFERENCE_IMPLEMENTATION"}},
        {"contains": {"const": "BEHAVIOR_CORE"}},
        {"contains": {"const": "NEUTRAL_ADAPTATION"}},
        {"contains": {"const": "PROJECT_ADAPTATION"}}
      ],
      "uniqueItems": true
    },
    "reference_implementation": {"type": "string", "minLength": 1},
    "exact": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "prohibited": {
      "type": "array",
      "items": {"type": "string"},
      "allOf": [
        {"contains": {"const": "NEUTRAL_ADAPTATION_IMPERSONATION"}},
        {"contains": {"const": "CANONICAL_REPLACEMENT"}},
        {"contains": {"const": "REUSABLE_PROMOTION"}},
        {"contains": {"const": "HUMAN_APPROVAL_CLAIM"}}
      ],
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
