{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.local/schemas/motion-visual-anatomy-contract.schema.json",
  "title": "Motion visual-anatomy contract",
  "type": "object",
  "required": ["schema_version", "layers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "layers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "source_selector", "dom_role", "dimensions", "positioning", "z_index", "color", "border", "radius", "shadow", "opacity", "transform", "transition", "relationship_to_rail", "relationship_to_card", "responsive_overrides", "motion_states"],
        "properties": {
          "role": {"type": "string", "minLength": 1}, "source_selector": {"type": "string", "minLength": 1}, "dom_role": {"type": "string", "minLength": 1},
          "dimensions": {}, "positioning": {}, "z_index": {}, "color": {}, "border": {}, "radius": {}, "shadow": {}, "opacity": {}, "transform": {}, "transition": {},
          "relationship_to_rail": {}, "relationship_to_card": {}, "responsive_overrides": {"type": "array"},
          "motion_states": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
