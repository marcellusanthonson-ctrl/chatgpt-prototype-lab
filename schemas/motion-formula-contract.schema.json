{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.local/schemas/motion-formula-contract.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "effect_id",
    "formula_required",
    "calculation_model",
    "coordinate_space",
    "inputs",
    "derived_values",
    "equations",
    "constants",
    "clamps",
    "invariants",
    "recalculation_triggers",
    "fallbacks",
    "customizable_coefficients",
    "locked_relations",
    "reduced_motion_formula"
  ],
  "properties": {
    "schema_version": {},
    "effect_id": {},
    "formula_required": {},
    "calculation_model": {},
    "coordinate_space": {},
    "inputs": {},
    "derived_values": {},
    "equations": {},
    "constants": {},
    "clamps": {},
    "invariants": {},
    "recalculation_triggers": {},
    "fallbacks": {},
    "customizable_coefficients": {},
    "locked_relations": {},
    "reduced_motion_formula": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formula_required": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "equations": {
            "type": "array",
            "minItems": 1
          },
          "invariants": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
