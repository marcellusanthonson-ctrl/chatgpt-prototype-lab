{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.local/schemas/motion-source-provenance.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "effect_id",
    "sources",
    "claims",
    "project_source_mutation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "effect_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1
    },
    "project_source_mutation": {
      "const": "PROHIBITED"
    }
  },
  "additionalProperties": false
}
