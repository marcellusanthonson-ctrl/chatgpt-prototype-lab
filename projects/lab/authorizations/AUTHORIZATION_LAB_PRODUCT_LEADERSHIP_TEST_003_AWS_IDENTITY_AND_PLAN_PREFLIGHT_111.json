  "scope": "AWS_IDENTITY_CONNECTIVITY_AND_TERRAFORM_PLAN_ONLY",
  "objective": "Authenticate through AWS IAM Identity Center with temporary credentials, verify the exact isolated account and region, initialize Terraform without a remote backend, produce and review a Terraform plan for the already published static package, and stop before any resource creation.",
  "required_human_inputs_before_grant": [
    "EXACT_ISOLATED_NON_PRODUCTION_AWS_ACCOUNT_ID",
    "EXACT_AWS_REGION",
    "IAM_IDENTITY_CENTER_START_URL",
    "IAM_IDENTITY_CENTER_REGION",
    "SSO_PERMISSION_SET_OR_ROLE_NAME",
    "LOCAL_AWS_PROFILE_NAME",
    "BUDGET_ALERT_OWNER_EMAIL",
    "CONFIRMED_MONTHLY_BUDGET_THRESHOLD_USD",
    "CONFIRMED_GOVERNANCE_RETENTION_DAYS",
    "CONFIRM_ACCOUNT_HAS_NO_PRODUCTION_WORKLOADS_OR_REAL_TEST_DATA"
  ],
  "proposed_allowed_actions": [
    "aws configure sso --profile <approved-profile>",
    "aws sso login --profile <approved-profile>",
    "aws sts get-caller-identity --profile <approved-profile>",
    "aws configure get region --profile <approved-profile>",
    "terraform init -backend=false -input=false",
    "terraform fmt -check -recursive",
    "terraform validate",
    "terraform plan -input=false -refresh=false -out=<local-plan-file> using only approved runtime variables",
    "terraform show -json <local-plan-file> into a local evidence file with account identifiers redacted before publication",
    "static and semantic inspection of the plan",
    "publish documentary evidence and a redacted plan summary after explicit grant"
  ],
  "forbidden_actions": [
    "TERRAFORM_APPLY",
    "TERRAFORM_DESTROY",
    "AWS_RESOURCE_CREATION_MODIFICATION_OR_DELETION",
    "CLOUDFORMATION_DEPLOY",
    "CREATE_OR_MODIFY_IAM_IDENTITY_CENTER",
    "CREATE_IAM_USERS_OR_LONG_LIVED_ACCESS_KEYS",
    "STORE_AWS_CREDENTIALS_TOKENS_OR_ACCOUNT_ID_IN_REPOSITORY",
    "MATERIALIZE_SECRET_VALUE",
    "UPLOAD_SENTINEL_OBJECTS",
    "EXECUTE_ROLE_ACCESS_TESTS",
    "EXECUTE_PRODUCT_LEADERSHIP_TEST_003",
    "GENERATE_TEST_FIXTURES_OUTPUTS_SCORES_ORACLES_MAPPINGS_OR_IDS",
    "ACTIVATE_OR_INTEGRATE_PRODUCT_LEADERSHIP",
    "MODIFY_SYMPHONIE_MAMMOTHSKILLS_OR_PRODUCTS"
  ],
  "mandatory_gates": [
    "REMOTE_HEAD_MATCHES_EXPECTED_PARENT_AT_GRANT_TIME_OR_IS_REBASED_BY_EXPLICIT_SUCCESSOR",
    "ACCOUNT_ID_MATCHES_EXPLICIT_HUMAN_INPUT",
    "ACCOUNT_CONFIRMED_ISOLATED_NON_PRODUCTION",
    "REGION_MATCHES_EXPLICIT_HUMAN_INPUT",
    "CALLER_IS_TEMPORARY_SSO_OR_ASSUMED_ROLE_NOT_ROOT_NOT_IAM_USER_ACCESS_KEY",
    "NO_AWS_CREDENTIAL_VALUE_IS_PRINTED_OR_PERSISTED",
    "PLAN_CONTAINS_ONLY_STATIC_PACKAGE_RESOURCES",
    "PLAN_CONTAINS_ZERO_OUT_OF_SCOPE_RESOURCES",
    "NO_RESOURCE_CHANGE_EXECUTED",
