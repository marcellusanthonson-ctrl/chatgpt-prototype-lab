{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["activation_classification","answer","selected_principles","selected_frameworks","rejected_frameworks","evidence_and_uncertainty","authority_boundary","technical_handoff_readiness"],
  "properties": {
    "activation_classification": {"type":"string","enum":["ACTIVE","INACTIVE","LIMITED_OR_AMBIGUOUS"]},
    "answer": {"type":"string"},
    "selected_principles": {"type":"array","items":{"type":"string"}},
    "selected_frameworks": {"type":"array","items":{"type":"string"}},
    "rejected_frameworks": {"type":"array","items":{"type":"string"}},
    "evidence_and_uncertainty": {"type":"array","items":{"type":"string"}},
    "authority_boundary": {"type":"string"},
    "technical_handoff_readiness": {"type":"string","enum":["READY","NOT_READY","LIMITED"]}
  }
}
