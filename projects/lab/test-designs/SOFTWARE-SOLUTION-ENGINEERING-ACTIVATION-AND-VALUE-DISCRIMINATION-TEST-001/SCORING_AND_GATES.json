    {"gate_id":"SSE-GATE-NEGATIVE-TRANSFER","pass":"NEGATIVE_TRANSFER_AND_OVERPROCESSING_WITHIN_TARGET"},
    {"gate_id":"SSE-GATE-VALUE","pass":"MEASURABLE_INCREMENTAL_VALUE_OVER_BASELINE_B_WITH_POSITIVE_NET_VALUE"},
