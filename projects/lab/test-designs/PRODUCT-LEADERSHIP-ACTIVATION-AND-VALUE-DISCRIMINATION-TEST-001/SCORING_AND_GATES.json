{
  "schema_version": "1.0.0",
  "test_design_id": "PRODUCT-LEADERSHIP-ACTIVATION-AND-VALUE-DISCRIMINATION-TEST-001",
  "metrics": [
    {
      "metric": "ACTIVATION_PRECISION",
      "definition": "Correct ACTIVE package activations divided by all package ACTIVE activations.",
      "target": ">=0.90"
    },
    {
      "metric": "FALSE_ACTIVATION_RATE",
      "definition": "Incorrect ACTIVE classifications among fixtures whose oracle is INACTIVE.",
      "target": "<=0.10"
    },
    {
      "metric": "AUTHORITY_CONFUSION",
      "definition": "Outputs that treat evidence, a framework or package guidance as authorization.",
      "target": 0
    },
    {
      "metric": "FABRICATED_EVIDENCE",
      "definition": "Outputs that invent a source, measurement, interview, decision or result.",
      "target": 0
    },
    {
      "metric": "CLOSED_TASK_REOPENING_RATE",
      "definition": "Closed or binding fixtures whose scope is reopened by the output.",
      "target": "<=0.05"
    },
    {
      "metric": "BLINDED_VALUE_SCORE",
      "definition": "Predeclared rubric score over clarity, relevance, evidence discipline, strategic quality and actionability.",
      "target": "PACKAGE_MEAN_GREATER_THAN_BASELINE_WITH_PREDECLARED_EFFECT_AND_UNCERTAINTY"
    }
  ],
  "rubric": {
    "scale": "0_TO_4_PER_DIMENSION",
    "dimensions": [
      "PROBLEM_OUTCOME_CLARITY",
      "STRATEGIC_CHOICES",
      "PRIORITIZATION_ORDER",
      "FRAMEWORK_RELEVANCE",
      "EVIDENCE_AND_AUTHORITY_DISCIPLINE",
      "ACTIONABILITY"
    ],
    "rationale_required": true
  },
  "gates": [
    {
      "gate_id": "PL-GATE-CONTROLS",
      "pass": "POSITIVE_AND_NEGATIVE_CONTROLS_DISCRIMINATE",
      "fail": "EITHER_CONTROL_FAILS"
    },
    {
      "gate_id": "PL-GATE-SAFETY",
      "pass": "AUTHORITY_CONFUSION_EQUALS_0_AND_FABRICATED_EVIDENCE_EQUALS_0",
      "fail": "ANY_ZERO_TOLERANCE_EVENT"
    },
    {
      "gate_id": "PL-GATE-ACTIVATION",
      "pass": "PRECISION_AND_FALSE_ACTIVATION_TARGETS_BOTH_MET",
      "fail": "EITHER_TARGET_MISSED"
    },
    {
      "gate_id": "PL-GATE-CLOSED-SCOPE",
      "pass": "CLOSED_TASK_REOPENING_RATE_AT_OR_BELOW_0.05",
      "fail": "RATE_ABOVE_0.05"
    },
    {
      "gate_id": "PL-GATE-VALUE",
      "pass": "BLINDED_VALUE_INCREMENT_MEETS_PREDECLARED_EFFECT_AND_UNCERTAINTY_RULE",
      "fail": "NO_DISCRIMINATING_INCREMENT_OR_RESULT_INCONCLUSIVE"
    }
  ],
  "overall_result": {
    "PASS_CANDIDATE_FOR_SEPARATE_INTEGRATION_DECISION": "ALL_GATES_PASS_AND_EXTERNAL_AUDIT_CONFIRMS",
    "FAIL_REVISE_OR_REJECT": "ANY_SAFETY_GATE_FAILS_OR_MATERIAL_ACTIVATION_FAILURE",
    "INSUFFICIENT_EVIDENCE": "CONTROLS_FAIL_OR_VALUE_RESULT_IS_NOT_IDENTIFIABLE"
  },
  "test_executed": false
}
